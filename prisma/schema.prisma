// Station 24 Fitness - Prisma Schema for PostgreSQL

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // url      = env("DATABASE_URL")
}

// ==========================================
// Enums for type-safe status fields
// ==========================================

enum MembershipStatus {
  prospect
  member
  inactive
}

enum Gender {
  male
  female
  other
}

enum DocumentType {
  CURP
  INE
  PASSPORT
  RFC
}

// ==========================================
// Prospects Table - Members/Prospects
// ==========================================

model Prospects {
  id              String   @id @default(uuid()) @db.Uuid
  email           String
  curp            String   @unique
  firstName       String   @map("first_name")
  lastName        String   @map("last_name")
  gender          Gender?
  birthDate       DateTime? @map("birth_date") @db.Timestamptz
  areaCode        String?  @map("area_code")
  phone           String   @unique
  planId          String?  @map("plan_id")
  idMember        Int?     @map("id_member")
  idBranch        Int?     @map("id_branch")
  branchName      String?  @map("branch_name")
  accessBlocked   Boolean  @default(false) @map("access_blocked")
  blockedReason   String?  @map("blocked_reason")
  documentType    DocumentType @default(CURP) @map("document_type")
  documentNumber  String?  @map("document_number")
  documentId      String?  @map("document_id")
  status          MembershipStatus @default(prospect) @map("status")
  membershipStatus String?  @map("membership_status")
  paymentPending  Boolean  @default(true) @map("payment_pending")
  syncEvoStatus     String?  @map("sync_evo_status")     // pending, syncing, synced, failed
  syncEvoError      String?  @map("sync_evo_error")     // mensaje de error si falló
  syncEvoAttemptedAt DateTime? @map("sync_evo_attempted_at") @db.Timestamptz
  syncEvoIdProspect Int?     @map("sync_evo_id_prospect") // ID del prospecto en Evo
  syncEvoIdSale     Int?     @map("sync_evo_id_sale")     // ID de la venta en Evo
  syncEvoIdCartToken String? @map("sync_evo_id_cart_token") // Token del cart en Evo
  syncEvoCartCheckoutLink String? @map("sync_evo_cart_checkout_link") // Link de checkout del cart

  // Address fields
  address         String?  @map("address")
  number          String?  @map("number")
  state           String?  @map("state")
  city            String?  @map("city")
  zipCode         String?  @map("zip_code")

  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  otpRequests    OtpRequests[]

  @@index([status])
  @@index([membershipStatus])
  @@index([planId])
  @@index([syncEvoStatus])
  @@map("prospects")
}

// ==========================================
// OTP Requests Table
// ==========================================

model OtpRequests {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  otp       String
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  prospect  Prospects @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("otp_requests")
}

// ==========================================
// Email Validation Logs Table
// ==========================================

model EmailValidationLogs {
  id                String   @id @default(uuid()) @db.Uuid
  email             String
  domain            String
  isDisposable      Boolean  @map("is_disposable")
  ipAddress         String?  @map("ip_address")
  userAgent         String?  @map("user_agent")
  validationContext String?  @map("validation_context")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([email])
  @@index([domain])
  @@index([createdAt(sort: Desc)])
  @@map("email_validation_logs")
}

